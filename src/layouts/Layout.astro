import '../styles/global.css';

import Background from '../components/Background.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  nav?: 'portfolio' | 'faq';
}

const { title, description, nav } = Astro.props;

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080711" />

    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <Background />
    <a class="skip sr-only" href="#main">Skip to content</a>
    {nav && <Header current={nav} />}
    <main id="main"><slot /></main>
    <Footer />

    <script>
      document.querySelectorAll<HTMLButtonElement>('[data-copy]')
        .forEach((button) => {
          const label = button.querySelector('.label');
          const original = label?.textContent ?? '';

          button.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(button.dataset.copy ?? '');

              if (label) {
                label.textContent = 'Copied!';
              }
            } 
            catch {
              if (label) {
                label.textContent = button.dataset.copy ?? '';
              }
            }

            setTimeout(() => {
              if (label) {
                label.textContent = original;
              }
            }, 1800);
          });
        });
    </script>
  </body>
</html>

<style is:global>
  .skip:focus {
    position: fixed;
    z-index: 100;
    top: 0.5rem;
    left: 0.5rem;
    width: auto;
    height: auto;
    clip: auto;
    padding: 0.6rem 1rem;
    background: #1b1236;
    border: 1px solid var(--violet);
    border-radius: 8px;
    color: #fff;
  }
</style>
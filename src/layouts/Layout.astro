import '../styles/global.css';
import Background from '../components/Background.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import { url } from '../config';

interface Props {
  title: string;
  description: string;
  nav?: 'portfolio' | 'faq';
  noindex?: boolean;
}

const { title, description, nav, noindex = false } = Astro.props;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080711" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <script is:inline>
      // Show the loader right away
      try { if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('is-loading'); } catch (e) {}
    </script>
  </head>

  <body class={nav ? 'has-header' : undefined}>
    <div class="loader" aria-hidden="true"><span class="ring"></span></div>
    <Background />
    <a class="skip sr-only" href="#main">Skip to content</a>
    {nav && <Header current={nav} />}
    <main id="main"><slot /></main>
    <Footer />

    <button class="to-top" type="button" aria-label="Back to top" hidden>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
    </button>

    <script>
      const root = document.documentElement;
      if (root.classList.contains('is-loading')) {
        const start = performance.now();
        let done = false;
        const finish = () => {
          if (done) return;
          done = true;
          const wait = Math.max(0, 550 - (performance.now() - start)); // Quick spin
          setTimeout(() => root.classList.remove('is-loading'), wait);
        };
        if (document.readyState === 'complete') finish();
        else addEventListener('load', finish, { once: true });
        setTimeout(finish, 3500);
        addEventListener('pageshow', (e) => { if (e.persisted) root.classList.remove('is-loading'); });
      }

      const btn = document.querySelector<HTMLButtonElement>('.to-top');
      if (btn) {
        const update = () => { btn.hidden = window.scrollY < 400; };
        addEventListener('scroll', update, { passive: true });
        update();
        btn.addEventListener('click', () => scrollTo({ top: 0 }));
      }

      document.querySelectorAll<HTMLButtonElement>('[data-copy]')
        .forEach((button) => {
          const label = button.querySelector('.label');
          const original = label?.textContent ?? '';

          button.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(button.dataset.copy ?? '');

              if (label) {
                label.textContent = 'Copied!';
              }
            } 
            catch {
              if (label) {
                label.textContent = button.dataset.copy ?? '';
              }
            }

            setTimeout(() => {
              if (label) {
                label.textContent = original;
              }
            }, 1800);
          });
        });
    </script>
  </body>
</html>

<style is:global>
  .skip:focus {
    position: fixed;
    z-index: 100;
    top: 0.5rem;
    left: 0.5rem;
    width: auto;
    height: auto;
    clip: auto;
    padding: 0.6rem 1rem;
    background: #1b1236;
    border: 1px solid var(--violet);
    border-radius: 8px;
    color: #fff;
  }

  .to-top {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 20;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    cursor: pointer;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgba(13, 9, 24, .92);
    border: 1px solid var(--border-strong);
    transition: box-shadow .25s, transform .2s;
    animation: rise .3s both;
  }

  .to-top[hidden] {
    display: none;
  }

  .to-top:hover {
    box-shadow: 0 0 16px rgba(168, 85, 247, .6);
    transform: translateY(-2px);
  }
</style>
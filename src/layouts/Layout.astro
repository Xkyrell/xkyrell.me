import '../styles/global.css';

import Background from '../components/Background.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  nav?: 'portfolio' | 'faq';
}

const { title, description, nav } = Astro.props;

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080711" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <Background />
    <a class="skip sr-only" href="#main">Skip to content</a>
    {nav && <Header current={nav} />}
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip:focus {
    position: fixed;
    z-index: 100;
    top: .5rem;
    left: .5rem;
    width: auto;
    height: auto;
    clip: auto;
    padding: .6rem 1rem;
    background: #1b1236;
    border: 1px solid var(--violet);
    border-radius: 8px;
    color: #fff;
  }
</style>
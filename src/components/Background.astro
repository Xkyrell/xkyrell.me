import { url } from '../config';

function rng(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;

    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;

    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const r = rng(20261017);
const f1 = (n: number) => +n.toFixed(1);

// Thin four-point sparkles
const sparkles = [
  [719, 108, 26],
  [421, 148, 14],
  [840, 189, 19],
  [405, 266, 10],
  [1144, 370, 15],
  [1317, 423, 12],
  [760, 493, 8],
  [1168, 42, 8],
].map(([x, y, R], i) => ({
  x,
  y,
  R,
  d: f1((4 + r() * 6) * 1.6),
  dl: f1(-r() * 12),
  flare: i % 3 === 0,
  lite: i % 2 === 1,
}));

// A few small stars scattered over the free part
const dots: {
  x: number;
  y: number;
  rad: number;
  o: number;
  d: number;
  dl: number;
  lite: boolean;
  mini: boolean;
}[] = [];

for (let n = 0; n < 2000 && dots.length < 30; n++) {
  const x = 20 + r() * 1630;
  const y = 15 + r() * 520;

  if (x > 1280 && x < 1530 && y < 310) continue; // moon
  if (x < 520 && y > 100) continue; // tree
  if (x > 1300 && y > 470) continue; // mountain
  if (y > 470 && x > 700 && x < 1000) continue; // bright horizon glow

  const mini = r() < 0.25;

  dots.push({
    x: f1(x),
    y: f1(y),
    rad: mini ? f1(4 + r() * 3) : f1(0.9 + r() * 1.3),
    o: f1(0.6 + r() * 0.4),
    d: f1((2.6 + r() * 7) * 1.6),
    dl: f1(-r() * 14),
    lite: dots.length % 2 === 0,
    mini,
  });
}

const star = (R: number) => {
  const k = f1(R * 0.12);

  return `M0 ${-R} Q${k} ${-k} ${R} 0 Q${k} ${k} 0 ${R} Q${-k} ${k} ${-R} 0 Q${-k} ${-k} 0 ${-R}Z`;
};

const fireflies = [
  [69, 851],
  [389, 844],
  [133, 910],
  [1567, 869],
  [1612, 893],
].map(([x, y]) => ({
  x,
  y,
  d: f1((3 + r() * 4) * 1.6),
  dl: f1(-r() * 8),
}));

const river = [
  [788, 815],
  [750, 839],
  [829, 878],
].map(([x, y]) => ({
  x,
  y,
  d: f1((2.5 + r() * 3) * 1.6),
  dl: f1(-r() * 6),
}));

<div class="bg" aria-hidden="true">
  <img
    class="art"
    src={url('/bg.webp')}
    alt=""
    decoding="async"
    fetchpriority="high"
  />

  <svg class="scene" viewBox="0 0 1673 940" focusable="false">
    <defs>
      <radialGradient id="halo">
        <stop offset="0" stop-color="#e6dcff" stop-opacity=".85" />
        <stop offset=".45" stop-color="#a98bff" stop-opacity=".25" />
        <stop offset="1" stop-color="#7c4dff" stop-opacity="0" />
      </radialGradient>

      <radialGradient id="ff">
        <stop offset="0" stop-color="#e2c4ff" stop-opacity=".9" />
        <stop offset="1" stop-color="#a855f7" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- Sparkles -->
    <g>
      {sparkles.map((s) => (
        <g transform={`translate(${s.x} ${s.y})`}>
          <g
            class:list={['spark', { flare: s.flare, lite: s.lite }]}
            style={`--d:${s.d}s;--dl:${s.dl}s`}
          >
            <circle r={s.R * 0.8} fill="url(#halo)" />
            <path d={star(s.R)} fill="#d9c8ff" />
            <circle r={Math.max(1.2, s.R * 0.07)} fill="#fff" />
          </g>
        </g>
      ))}
    </g>

    <!-- Small stars -->
    <g>
      {dots.map((d) =>
        d.mini ? (
          <g transform={`translate(${d.x} ${d.y})`}>
            <path
              class:list={['tw', { lite: d.lite }]}
              d={star(d.rad)}
              fill="#d9c8ff"
              style={`--o:${d.o};--d:${d.d}s;--dl:${d.dl}s`}
            />
          </g>
        ) : (
          <circle
            class:list={['tw', { lite: d.lite }]}
            cx={d.x}
            cy={d.y}
            r={d.rad}
            fill="#d9c8ff"
            style={`--o:${d.o};--d:${d.d}s;--dl:${d.dl}s`}
          />
        ),
      )}
    </g>

    <!-- Fireflies and light -->
    <g>
      {fireflies.map((f) => (
        <circle
          class="pulse"
          cx={f.x}
          cy={f.y}
          r="16"
          fill="url(#ff)"
          style={`--d:${f.d}s;--dl:${f.dl}s`}
        />
      ))}

      {river.map((l) => (
        <circle
          class="pulse soft"
          cx={l.x}
          cy={l.y}
          r="12"
          fill="url(#halo)"
          style={`--d:${l.d}s;--dl:${l.dl}s`}
        />
      ))}
    </g>

    <!-- Owl (from background): eyes that blink -->
    <g class="owl">
      <circle cx="213" cy="536.3" r="8.1" fill="#ffffff" />
      <circle cx="233.8" cy="536.3" r="8.1" fill="#ffffff" />
      <circle cx="213" cy="536.3" r="3.7" fill="#000000" />
      <circle cx="233.8" cy="536.3" r="3.7" fill="#000000" />

      <ellipse
        class="lid"
        cx="213"
        cy="536.3"
        rx="9"
        ry="9"
        fill="#030828"
      />
      <ellipse
        class="lid"
        cx="233.8"
        cy="536.3"
        rx="9"
        ry="9"
        fill="#030828"
      />
    </g>
  </svg>

  <i
    class="shoot"
    style="left:68%;top:6%;--d:41s;--dl:7s"
  ></i>
  <i
    class="shoot s2"
    style="left:42%;top:10%;--d:61s;--dl:29s"
  ></i>
</div>

<style is:global>
  .bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: #04031a;
    pointer-events: none;
  }

  .bg .art,
  .scene {
    --h: max(56.2vw, 100vh);

    position: absolute;
    left: 0;
    top: calc((100vh - var(--h)) * .15);
    width: max(100vw, 177.9vh);
    height: var(--h);
    max-width: none;
  }

  .scene .tw {
    opacity: var(--o);
    animation: twinkle var(--d) ease-in-out var(--dl) infinite;
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: var(--o);
    }

    50% {
      opacity: calc(var(--o) * .06);
    }
  }

  .spark {
    opacity: 0;
    animation: spark var(--d) ease-in-out var(--dl) infinite;
  }

  .spark.flare {
    animation-name: spark-flare;
  }

  @keyframes spark {
    0%,
    100% {
      opacity: .05;
    }

    50% {
      opacity: 1;
    }
  }

  @keyframes spark-flare {
    0%,
    100% {
      opacity: .05;
      transform: scale(.7);
    }

    45% {
      opacity: 1;
      transform: scale(1);
    }

    55% {
      opacity: 1;
      transform: scale(1.35);
    }

    70% {
      opacity: .7;
      transform: scale(1);
    }
  }

  .pulse {
    animation: pulse var(--d) ease-in-out var(--dl) infinite;
  }

  .pulse.soft {
    animation-name: pulse-soft;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: .2;
    }

    50% {
      opacity: 1;
    }
  }

  @keyframes pulse-soft {
    0%,
    100% {
      opacity: .05;
    }

    50% {
      opacity: .6;
    }
  }

  /* Rare shooting stars */
  .shoot {
    position: absolute;
    width: 170px;
    height: 2px;
    opacity: 0;
    border-radius: 2px;
    background: linear-gradient(
      90deg,
      #fff,
      rgba(190, 170, 255, .35) 45%,
      rgba(190, 170, 255, 0)
    );
    transform: translate(0, 0) rotate(-42deg);
    animation: shoot var(--d) linear var(--dl) infinite;
  }

  @keyframes shoot {
    0% {
      opacity: 0;
      transform: translate(0, 0) rotate(-42deg);
    }

    1% {
      opacity: 1;
    }

    6.5% {
      opacity: 0;
      transform: translate(-420px, 380px) rotate(-42deg);
    }

    100% {
      opacity: 0;
      transform: translate(-420px, 380px) rotate(-42deg);
    }
  }

  .owl .lid {
    transform-box: fill-box;
    transform-origin: 50% 0%;
    transform: scaleY(0);
    animation: blink 18s ease-in-out infinite;
  }

  @keyframes blink {
    0%,
    38%,
    44%,
    71%,
    73.6%,
    74.6%,
    77%,
    100% {
      transform: scaleY(0);
    }

    40.5%,
    72.2%,
    75.6% {
      transform: scaleY(1);
    }
  }

  @media (max-width: 700px) {
    .scene .lite {
      display: none;
    }

    .shoot.s2 {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene .tw,
    .spark,
    .pulse,
    .shoot,
    .owl .lid {
      animation: none !important;
    }

    .spark {
      opacity: .55;
    }

    .pulse {
      opacity: .5;
    }

    .shoot {
      display: none;
    }
  }
</style>

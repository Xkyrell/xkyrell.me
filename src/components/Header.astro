import { url } from '../config';

const { current } = Astro.props as {
  current: 'portfolio' | 'faq';
};

const items = [
  { key: 'home', label: 'Home', href: url('/') },
  { key: 'portfolio', label: 'Portfolio', href: url('/mcpfolio') },
  { key: 'faq', label: 'FAQ', href: url('/mcpfolio/faq') },
];

<header class="site-header">
  <nav class="container" aria-label="Main">
    <ul>
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={item.key === current ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    padding-top: 1rem;
  }

  ul {
    display: inline-flex;
    gap: 0.25rem;

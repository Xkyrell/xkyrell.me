import Layout from '../layouts/Layout.astro';
import { url } from '../config';
import { privacy as data, rich } from '../content';

<Layout
  title={data.title}
  description={data.description}
>
  <div class="container">
    <article class="card panel reveal">
      <h1>{data.heading}</h1>
      <p class="muted">{data.updated}</p>

      {data.sections.map((section) => (
        <>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <paragraph set:html={rich(paragraph)} />
          ))}
        </>
      ))}

      <p>
        <a href={url('/')}>{data.back}</a>
      </p>
    </article>
  </div>
</Layout>

<style>
  article {
    margin-top: 1.5rem;
  }

  h2 {
    margin-top: 1.6rem;
    font-size: 1.2rem;
  }
</style>

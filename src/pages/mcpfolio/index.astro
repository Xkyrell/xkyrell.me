import Layout from '../../layouts/Layout.astro';
import Icons from '../../components/Icons.astro';
import { projects } from '../../projects';
import { portfolio as data } from '../../content';
import { url } from '../../config';

const cover = (src: string) => (/^https?:\/\//.test(src) ? src : url(`/projects/${src}`));

const faces = ['front', 'back', 'right', 'left', 'top', 'bottom'];

<Layout
  title={data.title}
  description={data.description}
  nav="portfolio"
  noindex
>
  <div class="container">
    <h1 class="reveal" style="--i:0">{data.heading}</h1>
    <section
      class="card panel about reveal"
      style="--i:1"
      aria-labelledby="about"
    >
      <h2 id="about">{data.about.heading}</h2>
      <p class="intro">
        {data.about.text}
      </p>

      <h3 class="sub" id="stack">{data.stackHeading}</h3>
      <ol class="layers" aria-labelledby="stack">
        {data.stack.map((group) => (
          <li>
            <span class="node" aria-hidden="true"></span>
            <h4>{group.title}</h4>

            <ul class="chips">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section
      class="card panel projects reveal"
      style="--i:2"
      aria-labelledby="projects"
    >
      <h2 id="projects">{data.projectsHeading}</h2>
      {projects.length > 0 ? (
        <ul class="list">
          {projects.map((project) => (
            <li class="project">
              <div class="shot">
                <img src={cover(project.image)} alt={project.imageAlt ?? ''} loading="lazy" decoding="async" width="640" height="360" />
              </div>
              <div class="body">
                <h3>{project.title}</h3>
                <p class="desc">{project.description}</p>
                {project.tags && project.tags.length > 0 && (
                  <ul class="chips">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
                )}
                {project.video && (
                  <a class="btn watch" href={project.video} target="_blank" rel="noopener noreferrer">
                    <Icons name="play" />{data.watch}<Icons name="arrow" />
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <div class="window">
          <div class="bar" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
            <span></span>
          </div>
          <div class="screen">
            <div class="stage" aria-hidden="true">
              <div class="cube">
                {faces.map((face) => (
                  <b class={face}></b>
                ))}
              </div>

              <div class="shadow"></div>
            </div>
            <div class="copy">
              <p class="soon-label">{data.soon.label}</p>
              <p class="muted">{data.soon.text}</p>
            </div>
          </div>
        </div>
      )}
    </section>
  </div>
</Layout>

<style>
  h1 {
    margin-top: 1.5rem;
  }

  .card {
    margin-block: 1.5rem;
    padding: 1.8rem clamp(1.2rem, 4vw, 2.2rem);
  }

  .intro {
    margin: 0 0 1.8rem;
    max-width: 62ch;
  }

  .sub {
    font-size: 1.3rem;
    margin: 0 0 1.1rem;
  }

  .layers {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.6rem;
    position: relative;
  }

  .layers::before {
    content: '';
    position: absolute;
    left: 5px;
    top: .7rem;
    bottom: .7rem;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(
      180deg,
      rgba(168, 85, 247, .9),
      rgba(139, 92, 246, .15)
    );
  }

  .layers > li {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 13rem) 1fr;
    align-items: center;
    gap: .4rem 1.2rem;
    padding: .7rem 0;
    border-top: 1px solid rgba(139, 92, 246, .16);
  }

  .layers > li:first-child {
    border-top: 0;
  }

  .node {
    position: absolute;
    left: -1.6rem;
    top: 50%;
    width: 12px;
    height: 12px;
    margin-top: -6px;
    border-radius: 3px;
    background: #0d0918;
    border: 2px solid #a855f7;
    box-shadow: 0 0 12px rgba(168, 85, 247, .8);
    transition: background .3s var(--ease);
  }

  .layers > li:hover .node {
    background: #a855f7;
  }

  h4 {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 650;
    color: #e9defe;
  }

  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }

  .chips li {
    padding: .25rem .8rem;
    border-radius: 8px;
    font-size: .95rem;
    background: rgba(139, 92, 246, .16);
    border: 1px solid rgba(139, 92, 246, .45);
    transition:
      background .25s var(--ease),
      border-color .25s var(--ease),
      transform .25s var(--ease);
  }

  .chips li:hover {
    background: rgba(168, 85, 247, .32);
    border-color: #a855f7;
    transform: translateY(-2px);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.2rem;
  }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 300px) 1fr;
    gap: 1.4rem;
    align-items: center;
    padding: 1rem;
    border-radius: 14px;
    background: rgba(8, 6, 18, .4);
    border: 1px solid rgba(139, 92, 246, .4);
    transition:
      border-color .35s var(--ease),
      box-shadow .35s var(--ease);
  }

  .project:hover {
    border-color: var(--border-strong);
    box-shadow: 0 12px 36px -18px rgba(168, 85, 247, .7);
  }

  .shot {
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #0d0918;
    border: 1px solid rgba(139, 92, 246, .35);
  }

  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .8s var(--ease);
  }

  .project:hover .shot img {
    transform: scale(1.04);
  }

  .body h3 {
    margin: 0 0 .4rem;
    font-size: 1.25rem;
  }

  .desc {
    margin: 0 0 .8rem;
    color: var(--muted);
  }

  .body .chips {
    margin-bottom: 1rem;
  }

  .watch {
    min-height: 44px;
  }

  .projects h2 {
    margin-bottom: 1.1rem;
  }

  .window {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: rgba(8, 6, 18, .45);
    border: 1px solid rgba(139, 92, 246, .5);
    box-shadow:
      0 18px 50px -24px rgba(168, 85, 247, .6),
      inset 0 0 60px rgba(124, 58, 237, .08);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: .45rem;
    padding: .65rem .9rem;
    border-bottom: 1px solid rgba(139, 92, 246, .3);
    background: rgba(139, 92, 246, .08);
  }

  .bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(196, 181, 253, .35);
  }

  .bar span {
    margin-left: .6rem;
    height: 8px;
    width: min(220px, 40%);
    border-radius: 4px;
    background: rgba(196, 181, 253, .14);
  }

  .screen {
    position: relative;
    display: grid;
    grid-template-columns: minmax(180px, 260px) 1fr;
    align-items: center;
    gap: 1rem 2rem;
    padding: 2.4rem clamp(1.2rem, 4vw, 2.6rem);
    min-height: 260px;
    background:
      radial-gradient(
        circle at 20% 50%,
        rgba(168, 85, 247, .22),
        transparent 55%
      ),
      repeating-linear-gradient(
        0deg,
        rgba(196, 181, 253, .035) 0 1px,
        transparent 1px 28px
      ),
      repeating-linear-gradient(
        90deg,
        rgba(196, 181, 253, .035) 0 1px,
        transparent 1px 28px
      );
  }

  .screen::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(196, 181, 253, .09) 50%,
      transparent 60%
    );
    background-size: 250% 100%;
    animation: sheen 7s ease-in-out 2.5s infinite;
  }

  @keyframes sheen {
    0% {
      background-position: 150% 0;
    }

    45%,
    100% {
      background-position: -50% 0;
    }
  }

  .stage {
    position: relative;
    height: 170px;
    display: grid;
    place-items: center;
    perspective: 700px;
  }

  .cube {
    --s: 84px;
    position: relative;
    width: var(--s);
    height: var(--s);
    transform-style: preserve-3d;
    animation:
      turn 16s linear infinite,
      bob 5s ease-in-out infinite;
  }

  .cube b {
    position: absolute;
    inset: 0;
    border: 1.5px solid #c4b5fd;
    background: linear-gradient(
      135deg,
      rgba(168, 85, 247, .38),
      rgba(76, 29, 149, .5)
    );
    box-shadow:
      inset 0 0 22px rgba(196, 181, 253, .35),
      0 0 18px rgba(168, 85, 247, .35);
  }

  .cube b::after {
    content: '';
    position: absolute;
    inset: 22%;
    border: 1px solid rgba(233, 222, 254, .35);
  }

  .cube .front {
    transform: translateZ(calc(var(--s) / 2));
  }

  .cube .back {
    transform: rotateY(180deg) translateZ(calc(var(--s) / 2));
  }

  .cube .right {
    transform: rotateY(90deg) translateZ(calc(var(--s) / 2));
  }

  .cube .left {
    transform: rotateY(-90deg) translateZ(calc(var(--s) / 2));
  }

  .cube .top {
    transform: rotateX(90deg) translateZ(calc(var(--s) / 2));
  }

  .cube .bottom {
    transform: rotateX(-90deg) translateZ(calc(var(--s) / 2));
  }

  @keyframes turn {
    from {
      transform: rotateX(-24deg) rotateY(0);
    }

    to {
      transform: rotateX(-24deg) rotateY(360deg);
    }
  }

  @keyframes bob {
    0%,
    100% {
      translate: 0 -6px;
    }

    50% {
      translate: 0 6px;
    }
  }

  .shadow {
    position: absolute;
    bottom: 6px;
    width: 90px;
    height: 16px;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgba(168, 85, 247, .5),
      transparent
    );
    animation: shade 5s ease-in-out infinite;
  }

  @keyframes shade {
    0%,
    100% {
      transform: scale(1.1);
      opacity: .9;
    }

    50% {
      transform: scale(.8);
      opacity: .5;
    }
  }

  .copy {
    position: relative;
  }

  .copy p {
    margin: 0;
  }

  .soon-label {
    font-size: clamp(1.7rem, 4.5vw, 2.4rem);
    font-weight: 750;
    letter-spacing: -.01em;
    margin-bottom: .5rem !important;
    background: linear-gradient(
      90deg,
      #e9defe,
      #a78bfa 60%,
      #c084fc
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: none;
  }

  @media (max-width: 640px) {
    .project {
      grid-template-columns: 1fr;
    }

    .layers > li {
      grid-template-columns: 1fr;
    }

    .screen {
      grid-template-columns: 1fr;
      text-align: center;
      padding-block: 1.8rem;
    }

    .stage {
      height: 150px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cube {
      transform: rotateX(-24deg) rotateY(35deg);
    }
  }
</style>

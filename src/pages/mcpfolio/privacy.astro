import Layout from '../layouts/Layout.astro';
import { url, profile } from '../config';

<Layout
  title="Privacy Policy"
  description="How this website handles data."
>
  <div class="container">
    <article class="card panel">
      <h1>Privacy Policy</h1>
      <p class="muted">Last updated: 6 November 2026</p>

      <h2>Summary</h2>
      <p>
        This is a static personal website. It has no accounts, forms, comments,
        cookies, analytics or advertising, and it does not collect personal
        data itself.
      </p>

      <h2>Hosting</h2>
      <p>
        The site is hosted on GitHub Pages. When you visit, GitHub, as the
        hosting provider, may process technical data such as your IP address,
        browser type and request time in server logs. This processing is
        governed by the
        <a
          href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
          rel="noopener noreferrer"
        >
          GitHub Privacy Statement
        </a>;
        I do not have access to individual visitor logs.
      </p>

      <h2>Cookies and local storage</h2>
      <p>
        The site does not set cookies and does not store anything in your
        browser's local storage.
      </p>

      <h2>Third-party resources</h2>
      <p>
        All fonts, scripts, styles and images are served from this site.
        No third-party trackers, fonts or embeds are loaded.
      </p>

      <h2>Contact links</h2>
      <p>
        Links to GitHub and e-mail lead to external services with their own
        privacy policies. The Discord button only copies my username to your
        clipboard — nothing is sent anywhere. If you write to me by e-mail,
        I will use your message and address only to reply to you.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about this policy:
        <a href={`mailto:${profile.email}`}>{profile.email}</a>.
      </p>

      <p>
        <a href={url('/')}>← Back to the main page</a>
      </p>
    </article>
  </div>
</Layout>

<style>
  article {
    margin-top: 1.5rem;
  }

  h2 {
    margin-top: 1.6rem;
    font-size: 1.2rem;
  }
</style>
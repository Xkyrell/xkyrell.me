---
import Layout from '../layouts/Layout.astro';
import { url } from '../config';
import { notFound as data, privacy, placeholder } from '../content';
---

<Layout
  title={placeholder(data.title)}
  description={data.description}
>
  <main class="not-found">
    <article class="card panel reveal">
      <h1>{data.heading}</h1>
      <p>{data.description}</p>
      <a href={url('/')}>{privacy.back}</a>
    </article>
  </main>
</Layout>

<style>
  .not-found {
    width: 100%;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  article {
    width: fit-content;
    max-width: calc(100% - 2rem);
    padding: 2rem 3rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(5rem, 15vw, 7rem);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.07em;
  }

  p {
    margin: 1rem 0 1.5rem;
    color: var(--muted);
  }
</style>
